### Theme ####################################

set $bg       #2E3440
set $surface  #3B4252
set $surface2 #434C5E
set $text     #D8DEE9
set $muted    #81A1C1
set $accent   #88C0D0
set $urgent   #BF616A

font pango:JetBrains Mono 10

# Gaps
gaps inner 10
gaps outer 5
smart_gaps on

# Thin borders
default_border pixel 2
default_floating_border pixel 2

# class                 border     background text      indicator child_border
client.focused          $accent    $bg        $text     $accent   $accent
client.focused_inactive $surface2  $bg        $text     $surface2 $surface2
client.unfocused        $surface   $bg        $muted    $surface  $surface
client.urgent           $urgent    $bg        $text     $urgent   $urgent

# Logo key
set $mod Mod4

# Apps
set $term kitty
set $menu rofi -show drun
set $lock swaylock -f
set $files dolphin
set $office flatpak run org.onlyoffice.desktopeditors
set $browser helium
set $ai claude-desktop-unofficial

# Keyboard layout (US + Arabic, toggle with Alt+Shift)
input "type:keyboard" {
    xkb_layout "us,ara"
    xkb_options "grp:alt_shift_toggle"
}

bindsym $mod+Return exec $term                          # Open terminal
bindsym $mod+space exec $menu                             # App launcher
bindsym $mod+slash exec show-keybinds                     # Show keybindings guide
bindsym $mod+d exec $files                                # Open file manager
bindsym $mod+o exec $office                               # Open OnlyOffice
bindsym $mod+h exec $browser                              # Open web browser
bindsym $mod+c exec $ai                                   # Open Claude desktop
# Close focused window
bindsym $mod+q kill

# Manual lock only (no idle-based locking)
bindsym $mod+Escape exec pgrep -x swaylock || $lock

# Floating popups
for_window [app_id="pavucontrol"] floating enable, move position center
for_window [app_id="qt6ct"] floating enable, move position center

# Workspaces
# Switch to workspace
bindsym $mod+1 workspace number 1
bindsym $mod+2 workspace number 2
bindsym $mod+3 workspace number 3
bindsym $mod+4 workspace number 4

# Move focused window to workspace
bindsym $mod+Ctrl+1 move container to workspace number 1
bindsym $mod+Ctrl+2 move container to workspace number 2
bindsym $mod+Ctrl+3 move container to workspace number 3
bindsym $mod+Ctrl+4 move container to workspace number 4

# Waybar (managed by systemd --user, see: systemctl --user status waybar)

# No idle daemon: locking/suspend/dpms only happen via manual keybindings
exec_always pkill -x swayidle

# Wallpaper
output * bg /home/alduwaihy/Pictures/Wallpapers/icy-peaks.jpg fill

# SwayFX effects
blur enable
blur_xray disable
blur_passes 3
blur_radius 5
corner_radius 8
shadows enable
shadow_blur_radius 12
shadow_color #00000055
default_dim_inactive 0.1
animation_duration_ms 300

exec_always dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP=sway

include ~/.config/sway/config.d/*
include /etc/sway/config.d/*
